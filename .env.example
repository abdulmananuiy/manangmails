# Private Email Platform — environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. NEVER commit real secrets.

# PostgreSQL connection string (required).
# Local:  postgres://postgres:postgres@localhost:5432/email_platform
# Hosted:  e.g. Neon / Supabase / Vercel Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/email_platform

# Secret used to sign session cookies (min 32 random chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Shared secret the mail receiver uses to authenticate POST /api/inbound-email.
# The receiver sends it as header `x-api-secret`, or as an HMAC-SHA256 of the
# raw JSON body in header `x-signature` (hex). Keep it server-side only.
INBOUND_API_SECRET=change-me-to-a-long-random-inbound-secret

# One-time setup token for POST /api/setup (creates the first admin).
# Only works while NO admin exists yet. After the first admin is created the
# endpoint is permanently disabled. Remove/rotate after use.
SETUP_TOKEN=change-me-to-a-one-time-setup-token

# Optional: how email receiving is configured.
#   none        (default) Receiving: NOT CONFIGURED — addresses cannot receive mail yet.
#   provider    A Route B inbound provider posts signed events to /api/inbound-email.
#   selfhosted  A Route A self-hosted mail server posts signed events.
# Set this ONLY when a receiver is actually connected; the dashboard and admin
# receiver panel report the real status and never claim receiving works otherwise.
RECEIVER_MODE=none

# Local tests only (never set on Vercel): PG_MEM=1 runs `npm test` against an
# in-memory Postgres emulator instead of a real database.
# PG_MEM=1
